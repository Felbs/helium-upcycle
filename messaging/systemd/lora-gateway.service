[Unit]
Description=LoRa command-link gateway (loragw: answers/commands the laptop over LoRa)
After=lora-listener.service
Requires=lora-listener.service

[Service]
User=lora
ExecStart=/usr/bin/python3 -u /opt/helium-upcycle/messaging/loragw.py daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
